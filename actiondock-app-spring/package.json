{
  "name": "@actiondock/server",
  "version": "0.3.1",
  "description": "ActionDock official server",
  "author": "jay.wu <fjayblue@126.com>",
  "license": "MIT",
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/fjay/script-flow.git"
  },
  "bin": {
    "actiondock-server": "jdeploy-bundle/jdeploy.js"
  },
  "files": [
    "jdeploy-bundle"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "command-exists-promise": "^2.0.2",
    "node-fetch": "2.6.7",
    "shelljs": "^0.8.4",
    "tar": "^4.4.8",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "jdeploy": "^6.1.3"
  },
  "scripts": {
    "build:jar": "mvn -pl actiondock-app-spring -am package -DskipTests -f ../pom.xml",
    "jdeploy:package": "jdeploy package",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build:jar && npm run jdeploy:package"
  },
  "jdeploy": {
    "javaVersion": "21",
    "jar": "target/actiondock-app-spring.jar",
    "args": [
      "-Dfile.encoding=UTF-8"
    ],
    "title": "ActionDock Server",
    "commands": {
      "actiondock-server": {
        "description": "ActionDock official server",
        "implements": [
          "service_controller",
          "updater"
        ]
      }
    }
  }
}
