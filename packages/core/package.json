{
  "name": "@actiondock/core",
  "version": "2.7.0",
  "description": "ActionDock Core Engine - Project loader, runtime execution, SQLite storage, standalone builder, and skill exporter",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "bun": "./src/server/index.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "bun": "./src/project/index.ts",
      "import": "./dist/project/index.js",
      "default": "./dist/project/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "bun": "./src/registry/index.ts",
      "import": "./dist/registry/index.js",
      "default": "./dist/registry/index.js"
    },
    "./profile": {
      "types": "./dist/profile/index.d.ts",
      "bun": "./src/profile/index.ts",
      "import": "./dist/profile/index.js",
      "default": "./dist/profile/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "bun": "./src/graph/index.ts",
      "import": "./dist/graph/index.js",
      "default": "./dist/graph/index.js"
    },
    "./package": {
      "types": "./dist/package/index.d.ts",
      "bun": "./src/package/index.ts",
      "import": "./dist/package/index.js",
      "default": "./dist/package/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "test": "node ../../scripts/run-tests.ts"
  },
  "dependencies": {
    "@actiondock/sdk": "^2.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "actiondock",
    "core",
    "runtime",
    "storage",
    "builder"
  ],
  "author": "team4u",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team4u/actiondock.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/team4u/actiondock#readme",
  "bugs": {
    "url": "https://github.com/team4u/actiondock/issues"
  }
}
