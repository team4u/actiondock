{
  "name": "@actiondock/sdk",
  "version": "2.0.12",
  "description": "ActionDock SDK for defining and testing standalone AI Agent Actions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "test": "bun test"
  },
  "keywords": [
    "actiondock",
    "agent",
    "actions",
    "skill",
    "ai",
    "mcp"
  ],
  "author": "team4u",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team4u/actiondock.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/team4u/actiondock#readme",
  "bugs": {
    "url": "https://github.com/team4u/actiondock/issues"
  }
}
