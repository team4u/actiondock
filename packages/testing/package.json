    "test": "bun test"
  },
  "dependencies": {
    "@actiondock/core": "workspace:*",
    "@actiondock/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "keywords": ["actiondock", "testing", "agent", "actions", "mock"],
  "author": "team4u",
  "license": "Apache-2.0"
