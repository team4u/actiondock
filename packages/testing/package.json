{
  "name": "@actiondock/testing",
  "version": "2.1.0",
  "description": "ActionDock Test Runtime for testing Actions with real Core execution semantics",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "test": "node ../../scripts/run-tests.ts"
  },
  "dependencies": {
    "@actiondock/core": "^2.1.0",
    "@actiondock/sdk": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "actiondock",
    "testing",
    "agent",
    "actions",
    "mock"
  ],
  "author": "team4u",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team4u/actiondock.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/team4u/actiondock#readme",
  "bugs": {
    "url": "https://github.com/team4u/actiondock/issues"
  }
}
