{
  "name": "@actiondock/cli",
  "version": "2.0.0",
  "description": "ActionDock CLI facade for developing, testing, building, and exporting standalone Agent Actions and Skills",
  "type": "module",
  "bin": {
    "ac": "./bin/ac.js"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
