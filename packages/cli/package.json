{
  "name": "@actiondock/cli",
  "version": "2.0.2",
  "description": "ActionDock CLI facade for developing, testing, building, and exporting standalone Agent Actions and Skills",
  "type": "module",
  "bin": {
    "ad": "./bin/ad.js",
    "actiondock": "./bin/ad.js"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "bin",
    "src",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun"
  },
  "dependencies": {
    "@actiondock/builder": "workspace:*",
    "@actiondock/core": "workspace:*",
    "@actiondock/mcp": "workspace:*",
    "@actiondock/runtime-cli": "workspace:*",
    "@actiondock/runtime-node": "workspace:*",
    "@actiondock/sdk": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "keywords": ["actiondock", "ad", "agent", "cli", "skill", "builder", "mcp"],
  "author": "team4u",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team4u/actiondock.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/team4u/actiondock#readme",
  "bugs": {
    "url": "https://github.com/team4u/actiondock/issues"
  }
}
