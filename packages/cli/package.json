{
  "name": "@actiondock/cli",
  "version": "2.2.0",
  "description": "ActionDock CLI facade for developing, testing, building, and exporting standalone Agent Actions and Skills",
  "type": "module",
  "bin": {
    "ad": "./bin/ad.js",
    "actiondock": "./bin/ad.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/build.ts",
    "test": "node ../../scripts/run-tests.ts"
  },
  "dependencies": {
    "@actiondock/builder": "^2.2.0",
    "@actiondock/core": "^2.2.0",
    "@actiondock/mcp": "^2.2.0",
    "@actiondock/runtime-node": "^2.2.0",
    "@actiondock/sdk": "^2.2.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "actiondock",
    "ad",
    "agent",
    "cli",
    "skill",
    "builder",
    "mcp"
  ],
  "author": "team4u",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team4u/actiondock.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/team4u/actiondock#readme",
  "bugs": {
    "url": "https://github.com/team4u/actiondock/issues"
  }
}
