{
  "name": "@actiondock/runtime-bun",
  "version": "2.0.12",
  "description": "Bun Runtime Adapters for ActionDock (bun:sqlite, Bun.serve, Bun.spawn)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@actiondock/core": "^2.0.12",
    "@actiondock/sdk": "^2.0.12"
  },
  "peerDependencies": {
    "@types/bun": ">=1.2.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": ">=1.2.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "actiondock",
    "runtime",
    "bun",
    "sqlite"
  ],
  "author": "team4u",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team4u/actiondock.git",
    "directory": "packages/runtime-bun"
  },
  "homepage": "https://github.com/team4u/actiondock#readme",
  "bugs": {
    "url": "https://github.com/team4u/actiondock/issues"
  }
}
