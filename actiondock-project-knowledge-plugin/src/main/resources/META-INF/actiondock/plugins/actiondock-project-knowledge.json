{
  "pluginId": "actiondock-project-knowledge",
  "name": "ActionDock Project Knowledge",
  "description": "Built-in project knowledge plugin with code-first repository scanning, staging validation, and formal publish.",
  "version": "2.0.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultExecutor": {
        "type": "string",
        "title": "Default Executor"
      }
    }
  },
  "defaultConfig": {
    "defaultExecutor": "auto"
  },
  "actions": [
    {
      "action": "generate",
      "title": "Generate Project Knowledge",
      "description": "Scan the repository, generate a compact knowledge pack into staging, validate it, and publish formal documents only when validation passes.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath"],
        "properties": {
          "repoPath": {"type": "string"},
          "evidenceFiles": {"type": "array", "items": {"type": "string"}},
          "audience": {"type": "string"},
          "detailLevel": {"type": "string"},
          "aiProfile": {"type": "string"},
          "aiProfiles": {
            "type": "object",
            "properties": {
              "discovery": {"type": "string"},
              "writer": {"type": "string"}
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {"type": "string"},
          "repoPath": {"type": "string"},
          "workspacePath": {"type": "string"},
          "changedFiles": {"type": "array"},
          "documents": {"type": "array"},
          "reportPath": {"type": "string"},
          "qualityGate": {"type": "object"},
          "published": {"type": "boolean"}
        }
      }
    },
    {
      "action": "validate",
      "title": "Validate Project Knowledge",
      "description": "Validate formal project knowledge documents for structural and content hygiene.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath"],
        "properties": {
          "repoPath": {"type": "string"}
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "issues": {"type": "array"}
        }
      }
    }
  ]
}
