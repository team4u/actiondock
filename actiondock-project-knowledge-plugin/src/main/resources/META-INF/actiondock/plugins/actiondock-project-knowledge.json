{
  "pluginId": "actiondock-project-knowledge",
  "name": "ActionDock Project Knowledge",
  "description": "Built-in OCKB project knowledge plugin with async Chief/Planner/Worker agent orchestration, phased reconciliation, and ACTIONDOCK.md entry.",
  "version": "3.0.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultExecutor": {
        "type": "string",
        "title": "Default Executor"
      }
    }
  },
  "defaultConfig": {
    "defaultExecutor": "internal"
  },
  "actions": [
    {
      "action": "init",
      "title": "Initialize OCKB Knowledge Base",
      "description": "Start an async OCKB initialization run. The plugin creates Chief, Planner, and Worker agents through the selected runner, then validates the result.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath"],
        "properties": {
          "repoPath": {"type": "string"},
          "evidenceFiles": {"type": "array", "items": {"type": "string"}},
          "audience": {"type": "string"},
          "detailLevel": {"type": "string"},
          "aiProfile": {"type": "string"},
          "runner": {"type": "object"}
        }
      },
      "outputSchema": {"type": "object"}
    },
    {
      "action": "refresh",
      "title": "Refresh OCKB Knowledge Base",
      "description": "Start a manually triggered async refresh run.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath"],
        "properties": {
          "repoPath": {"type": "string"},
          "changedFiles": {"type": "array", "items": {"type": "string"}},
          "runner": {"type": "object"}
        }
      },
      "outputSchema": {"type": "object"}
    },
    {
      "action": "ingest",
      "title": "Ingest Manual Knowledge Sources",
      "description": "Start a manually triggered async ingest run for files or directories.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath"],
        "properties": {
          "repoPath": {"type": "string"},
          "sources": {"type": "array", "items": {"type": "string"}},
          "runner": {"type": "object"}
        }
      },
      "outputSchema": {"type": "object"}
    },
    {
      "action": "validate",
      "title": "Validate OCKB Knowledge Base",
      "description": "Validate ACTIONDOCK.md and the OCKB pure Markdown document tree.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath"],
        "properties": {
          "repoPath": {"type": "string"}
        }
      },
      "outputSchema": {"type": "object"}
    },
    {
      "action": "getRun",
      "title": "Get Knowledge Run",
      "description": "Read an async OCKB run snapshot.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath", "runId"],
        "properties": {
          "repoPath": {"type": "string"},
          "runId": {"type": "string"}
        }
      },
      "outputSchema": {"type": "object"}
    },
    {
      "action": "cancelRun",
      "title": "Cancel Knowledge Run",
      "description": "Mark an async OCKB run as cancelled.",
      "inputSchema": {
        "type": "object",
        "required": ["repoPath", "runId"],
        "properties": {
          "repoPath": {"type": "string"},
          "runId": {"type": "string"}
        }
      },
      "outputSchema": {"type": "object"}
    }
  ]
}
