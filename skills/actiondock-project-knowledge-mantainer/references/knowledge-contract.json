{
  "version": 2,
  "actions": [
    "generate",
    "validate"
  ],
  "inputs": {
    "required": [
      "repoPath"
    ],
    "optional": [
      "evidenceFiles",
      "audience",
      "detailLevel",
      "aiProfile",
      "aiProfiles"
    ],
    "defaults": {
      "audience": "balanced",
      "detailLevel": "standard"
    }
  },
  "outputs": {
    "entry": "ACTIONDOCK.md",
    "report": "KNOWLEDGE_REPORT.md",
    "generatedRoots": [
      "docs/project"
    ],
    "workspaceRoot": ".actiondock/project-knowledge",
    "stateFile": ".actiondock/project-knowledge/state.json",
    "stagingRoot": ".actiondock/project-knowledge/staging/<sessionId>"
  },
  "workflow": {
    "phaseOrder": [
      "scan",
      "generate",
      "stage-validate",
      "publish"
    ],
    "formalWritePhases": [
      "publish"
    ]
  },
  "aiRoles": {
    "writer": "AI drafts a compact evidence-bound knowledge pack from the scanned repository."
  }
}
