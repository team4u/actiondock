{
  "version": 3,
  "actions": [
    "init",
    "refresh",
    "ingest",
    "validate",
    "getRun",
    "cancelRun"
  ],
  "inputs": {
    "required": [
      "repoPath"
    ],
    "optional": [
      "aiProfile",
      "runner",
      "changedFiles",
      "sources"
    ]
  },
  "outputs": {
    "entry": "ACTIONDOCK.md",
    "knowledgeRoot": ".knowledge_base",
    "summary": ".knowledge_base/SUMMARY.md",
    "workspaceRoot": ".actiondock/project-knowledge",
    "runSnapshots": ".actiondock/project-knowledge/runs/<runId>.json"
  },
  "workflow": {
    "phaseOrder": [
      "submit",
      "agent-maintain",
      "validate",
      "record-run"
    ],
    "formalWritePhases": [
      "agent-maintain"
    ]
  },
  "aiRoles": {
    "maintainer": "Agent directly reads code and maintains ACTIONDOCK.md plus .knowledge_base Markdown documents."
  }
}
