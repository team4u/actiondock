{
  "version": 4,
  "actions": [
    "init",
    "refresh",
    "ingest",
    "validate",
    "getRun",
    "cancelRun"
  ],
  "inputs": {
    "required": [
      "repoPath"
    ],
    "optional": [
      "aiProfile",
      "runner",
      "changedFiles",
      "sources"
    ]
  },
  "outputs": {
    "entry": "ACTIONDOCK.md",
    "knowledgeRoot": ".knowledge_base",
    "summary": ".knowledge_base/SUMMARY.md",
    "workspaceRoot": ".actiondock/project-knowledge",
    "runSnapshots": ".actiondock/project-knowledge/runs/<runId>.json",
    "errorLog": ".knowledge_base/07_Maintenance_and_Ops/ERRORS.md"
  },
  "pillars": [
    ".knowledge_base/01_Architecture_Overview",
    ".knowledge_base/02_API_Specifications",
    ".knowledge_base/03_Data_Models",
    ".knowledge_base/04_Business_Flows",
    ".knowledge_base/05_Agent_Tools_and_CLI",
    ".knowledge_base/06_Infra_and_Env",
    ".knowledge_base/07_Maintenance_and_Ops"
  ],
  "workflow": {
    "phaseOrder": [
      "inspect",
      "chief-plan",
      "domain-plan",
      "worker-reconcile",
      "finalize-entry",
      "validate",
      "record-run"
    ],
    "formalWritePhases": [
      "worker-reconcile",
      "finalize-entry"
    ]
  },
  "aiRoles": {
    "chief": "Chief Architect Agent routes changed paths into ordered OCKB phases.",
    "planner": "Domain Planner Agents inspect their domain and output UPSERT/PRUNE tasks.",
    "worker": "Specialized Worker Agents reconcile one physical Markdown target at a time."
  }
}
