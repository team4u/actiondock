{
  "version": "4.4.1",
  "release": "adaptive-flow-plan-a",
  "name": "project-knowledge-maintainer",
  "description": "Adaptive project knowledge base maintainer with hard safety boundaries, scale-triggered planning depth, and lighter execution for coding agents such as Codex.",
  "language": {
    "skillLanguage": "zh-Hans",
    "defaultDocumentLanguage": "zh-Hans",
    "preserveExistingProjectLanguageWhenClear": true,
    "keepIdentifiersPathsAndJsonKeysInOriginalLanguage": true
  },
  "inputs": {
    "required": [
      "repoPath"
    ],
    "optional": [
      "operation",
      "changedFiles",
      "inboxPaths",
      "repair",
      "scenarioHint",
      "workspaceScopeHint",
      "forceDocumentSetPlan",
      "maxPlanningDepth"
    ],
    "defaults": {
      "operation": "auto",
      "repair": false,
      "forceDocumentSetPlan": false,
      "maxPlanningDepth": "auto"
    }
  },
  "inputOperations": [
    "auto",
    "init",
    "refresh",
    "ingest",
    "validate"
  ],
  "resolvedOperations": [
    "init",
    "refresh",
    "ingest",
    "validate"
  ],
  "operationResolution": {
    "rule": "operation=auto 是合法输入值；Router 先尊重用户明确意图，再按仓库状态解析为 init、refresh、ingest 或 validate 之一。",
    "autoResolution": [
      {
        "when": "用户明确要求只验证、检查知识库状态，或 operation=validate",
        "resolvedOperation": "validate"
      },
      {
        "when": "用户明确要求处理 inboxPaths、吸收 .kb_inbox/ 材料，或 operation=ingest",
        "resolvedOperation": "ingest"
      },
      {
        "when": "用户明确要求初始化，或 operation=init",
        "resolvedOperation": "init"
      },
      {
        "when": "未明确指定操作，且 ACTIONDOCK.md 或 docs/ 缺失",
        "resolvedOperation": "init"
      },
      {
        "when": "未明确指定操作，且已有正式知识库",
        "resolvedOperation": "refresh"
      }
    ],
    "outputRule": "Router output 的 operation 字段应写 resolved operation，不写 auto。"
  },
  "adaptiveFlow": {
    "profiles": {
      "lite": {
        "scale": [
          "XS",
          "S"
        ],
        "pipeline": [
          "route_lite",
          "apply",
          "validate_lite"
        ],
        "documentSetPlan": "not_required_unless_granularity_risk",
        "domainOutput": "activated_only",
        "taskPlan": "optional_minimal_task_list",
        "validateDepth": "changed_targets_and_entry_links"
      },
      "standard": {
        "scale": [
          "M"
        ],
        "pipeline": [
          "route",
          "task_plan",
          "apply",
          "validate"
        ],
        "documentSetPlan": "required_when_new_leaf_docs_or_index_risk",
        "domainOutput": "activated_plus_risky_skips",
        "taskPlan": "required",
        "validateDepth": "changed_targets_and_related_navigation"
      },
      "structured": {
        "scale": [
          "L"
        ],
        "pipeline": [
          "route",
          "document_set_plan",
          "task_plan",
          "phased_apply",
          "validate"
        ],
        "documentSetPlan": "required",
        "domainOutput": "activated_plus_material_skips",
        "taskPlan": "required",
        "validateDepth": "full_changed_scope"
      },
      "partitioned": {
        "scale": [
          "XL"
        ],
        "pipeline": [
          "route",
          "workspace_scope",
          "noise_filter",
          "document_set_plan",
          "task_plan",
          "phased_apply",
          "validate"
        ],
        "documentSetPlan": "required_per_workspace_or_partition",
        "domainOutput": "activated_plus_material_skips",
        "taskPlan": "required_per_partition",
        "validateDepth": "partition_and_cross_entry_consistency"
      },
      "validate_only": {
        "scale": [
          "XS",
          "S",
          "M",
          "L",
          "XL"
        ],
        "pipeline": [
          "route_lite",
          "validate"
        ],
        "documentSetPlan": "not_applicable_unless_repair",
        "domainOutput": "validation_scope_only",
        "taskPlan": "not_applicable_unless_repair",
        "validateDepth": "requested_scope"
      }
    },
    "documentSetPlanRequiredWhen": [
      "scale_in_L_or_XL",
      "forceDocumentSetPlan_true",
      "scale_M_and_new_leaf_doc_expected",
      "target_is_navigation_but_evidence_requires_substantive_leaf",
      "operation_init_for_nontrivial_repo",
      "operation_ingest_with_multiple_inbox_items_or_runbook_diagnosis_split",
      "validator_finding_index_content_sink",
      "validator_finding_category_under_split",
      "validator_finding_missing_required_leaf_doc",
      "validator_finding_document_set_plan_missing_when_required",
      "user_requests_plan_a_or_complete_document_set",
      "validator_finding_planner_underplanning",
      "validator_finding_delegated_discovery_to_worker"
    ],
    "documentSetPlanOptionalWhen": [
      "scale_XS_or_S_without_new_entity",
      "single_existing_leaf_doc_update",
      "navigation_only_link_or_status_update",
      "validate_without_repair"
    ],
    "miniPlanAllowed": true,
    "miniPlanRule": "Worker proposed_extra_tasks is an overflow/replan mechanism only. If the missing leaf doc was discoverable during Plan A, Validator must report planner_underplanning; Planner must not delegate normal document discovery to Worker."
  },
  "references": [
    "references/contract.json",
    "references/playbook.md",
    "references/scenario-matrix.md",
    "references/domain-map.md",
    "references/evidence-search.md",
    "references/document-granularity.md",
    "references/document-set-planning.md",
    "references/prompts.md",
    "references/validator.md",
    "references/actiondock-template.md"
  ],
  "roles": {
    "router": "Router",
    "planners": [
      "Architecture_Planner",
      "API_Spec_Planner",
      "Data_Model_Planner",
      "Business_Flow_Planner",
      "Agent_Tool_Planner",
      "Infra_Env_Planner",
      "Maintenance_Ops_Planner"
    ],
    "worker": "Worker",
    "validator": "Validator"
  },
  "outputs": {
    "entry": "ACTIONDOCK.md",
    "entryTemplate": "references/actiondock-template.md",
    "formalRoot": "docs",
    "inboxRoot": ".kb_inbox",
    "reports": {
      "init": "KNOWLEDGE_INIT_REPORT.md",
      "refresh": "KNOWLEDGE_UPDATE_REPORT.md",
      "ingest": "KNOWLEDGE_INGEST_REPORT.md",
      "validate": "KNOWLEDGE_VALIDATE_REPORT.md"
    },
    "errorLog": "docs/ops/maintenance/errors.md"
  },
  "documentationDomains": [
    "Architecture_Planner",
    "API_Spec_Planner",
    "Data_Model_Planner",
    "Business_Flow_Planner",
    "Agent_Tool_Planner",
    "Infra_Env_Planner",
    "Maintenance_Ops_Planner"
  ],
  "router": {
    "outputFieldsBase": [
      "operation",
      "scale",
      "flow_profile",
      "changed_files_basis",
      "activated_domains",
      "reasoning_summary"
    ],
    "outputFieldsWhenRelevant": [
      "phases",
      "inbox_classification",
      "skipped_domains",
      "change_types",
      "workspace_scope",
      "special_flags",
      "noise_filters",
      "document_set_plan_required",
      "document_set_plan_reason"
    ],
    "phaseFields": [
      "phase_num",
      "domains_to_activate",
      "reason",
      "selection_mode"
    ],
    "rules": [
      "Router 只做范围、领域、阶段、规模和 inbox 分类；不写文件、不产出正文。",
      "XS/S 使用 route-lite：输出必要字段即可，不机械列出七个 domain 的 skipped reason。",
      "M/L/XL 输出 activated domains；只有 material skip、风险 skip 或用户范围冲突需要显式 skipped_domains。",
      "domains_to_activate 只能包含 documentationDomains 中的 Planner 名称。",
      "operation=auto 时，不因 .kb_inbox/ 存在自动 ingest；只有用户明确要求处理 inbox 时才 ingest。",
      "大量 changedFiles 时必须先降噪，记录 generated、format-only、lockfile-only、build 输出等 skipped noise。",
      "monorepo 或多服务仓库必须输出 workspace_scope；不知道时输出空数组并说明证据不足。",
      "Router 决定 document_set_plan_required；XS/S 默认 false，L/XL 默认 true，M 按 granularity 风险判断。"
    ],
    "inboxClassificationValues": [
      "ops_or_diagnosis",
      "change_intent",
      "unrelated",
      "unsafe",
      "preserve_for_human"
    ],
    "workspaceScopeFields": [
      "scope_id",
      "kind",
      "root_path",
      "reason"
    ],
    "noiseFilterFields": [
      "item",
      "classification",
      "reason"
    ],
    "noiseFilterClassificationValues": [
      "generated_or_format_only",
      "build_output",
      "dependency_output",
      "format_only",
      "lockfile_only_auxiliary",
      "outside_scope",
      "test_snapshot_noise",
      "vendor_or_third_party",
      "semantic_auxiliary"
    ]
  },
  "planner": {
    "taskRequiredFields": [
      "task_id",
      "action",
      "domain",
      "target_path",
      "focus_code_entity",
      "evidence_paths",
      "depends_on",
      "confidence",
      "clue"
    ],
    "allowedActions": [
      "UPSERT",
      "PRUNE"
    ],
    "allowedConfidence": [
      "high",
      "medium",
      "low"
    ],
    "outputShapes": {
      "lite": {
        "required": [
          "tasks",
          "skipped"
        ],
        "optional": [
          "document_set_plan"
        ]
      },
      "standard": {
        "required": [
          "tasks",
          "skipped"
        ],
        "optional": [
          "document_set_plan"
        ]
      },
      "structured": {
        "required": [
          "document_set_plan",
          "tasks",
          "skipped"
        ]
      },
      "partitioned": {
        "required": [
          "document_set_plan",
          "tasks",
          "skipped"
        ]
      }
    },
    "rules": [
      "显然少列 leaf docs 应被 Validator 报告为 planner_underplanning。",
      "Planner 不得把“剩余文档发现 / 子文档补充 / 实体拆分”交给 Worker；proposed_extra_tasks 只是异常溢出机制。",
      "Plan A 每个 category 必须包含 coverage_basis、coverage_assertion、scope_boundary、excluded_candidates。",
      "Plan A 必须覆盖 existing、must、should、candidate；证据不足但有结构信号时使用 defer/candidate，不得省略。",
      "当 document_set_plan_required=true 时，Planner 必须先输出 Plan A：当前 scope 下完整预期 leaf-doc 集合，再输出 tasks。",
      "Planner 只读证据并产出 target_path 级任务；不写文件。",
      "XS/S 可直接产出最小 task list；除非 Router 标记 document_set_plan_required，否则不强制 document_set_plan。",
      "M 若涉及新 leaf doc、index 风险或多实体拆分，必须先产出 document_set_plan。",
      "L/XL 必须先产出 document_set_plan，再产出 tasks。",
      "一个任务对应一个最终 target_path。",
      "优先更新已有 leaf substantive doc；不要把 index/navigation doc 当作正文承载页。",
      "如果只有 index.md 存在且需要写正文事实，Planner 应创建 leaf doc 任务，并可另建 index navigation 任务。",
      "无证据支持时返回 tasks: [] 和 skipped，不发明 NOOP。",
      "PRUNE target_path 必须是正式输出路径，或 operation=ingest 且位于 .kb_inbox/ 的已成功吸收材料。",
      "target_path 以 /index.md 结尾或为入口型 http.md/events.md/workspaces.md 时，只能生成 navigation update 任务。"
    ],
    "taskOptionalFields": [
      "scale",
      "flow_profile",
      "change_types",
      "workspace_scope",
      "edit_mode",
      "breaking_impact",
      "rename_map",
      "noise_filters",
      "compatibility_required",
      "doc_kind",
      "leaf_doc_required",
      "granularity_reason",
      "index_update_for",
      "from_document_set_plan",
      "document_set_item_path",
      "proposed_followup"
    ]
  },
  "documentSetPlan": {
    "requiredFields": [
      "category",
      "index_path",
      "leaf_docs",
      "coverage_basis",
      "coverage_assertion",
      "scope_boundary",
      "excluded_candidates"
    ],
    "leafDocFields": [
      "path",
      "title",
      "status",
      "priority",
      "reason",
      "evidence_paths"
    ],
    "optionalLeafDocFields": [
      "defer_reason",
      "index_path",
      "owner_domain",
      "workspace_scope"
    ],
    "statuses": [
      "create",
      "update",
      "keep",
      "defer",
      "deprecate",
      "prune_candidate"
    ],
    "priorities": [
      "must",
      "should",
      "candidate"
    ],
    "rule": "document_set_plan 是分类下 leaf docs 的全集规划，不是单篇文档标题大纲；只有 required_when 触发时才是硬要求，但一旦触发即必须完整。",
    "categoryCompletenessFields": [
      "coverage_basis",
      "coverage_assertion",
      "scope_boundary",
      "excluded_candidates"
    ],
    "completenessRule": "When document_set_plan_required=true, Planner must enumerate the expected leaf-doc set for the current scope before producing tasks. It must prefer defer/candidate items over omission and must not delegate discovery to Worker.",
    "leafDocCoverageClasses": [
      "existing",
      "must",
      "should",
      "candidate"
    ]
  },
  "worker": {
    "maxRetries": 3,
    "allowedActions": [
      "UPSERT",
      "PRUNE"
    ],
    "statusValues": [
      "COMPLETED",
      "FAILED",
      "NEEDS_REPLAN"
    ],
    "outputRequiredFields": [
      "status",
      "target_path",
      "files_read",
      "files_changed",
      "evidence_gaps",
      "warnings",
      "edit_mode",
      "scenario_notes"
    ],
    "outputOptionalFields": [
      "proposed_extra_tasks",
      "blocked_by"
    ],
    "rules": [
      "每个 Worker 只拥有一个 target_path；同一 target_path 不允许多个 Worker 并发写。",
      "Worker 可以读取相关证据、相关已有文档和前序 phase 输出，但只能写自己的 target_path。",
      "serial 模式下，主 agent 可以临时进入 Worker role 写一个 target_path，但必须保持边界。",
      "默认做最小必要编辑；保留人工段落、备注、TODO、链接和上下文。",
      "除非证据表明整篇 stale、结构阻碍维护或用户要求重写，否则不要整体重写。",
      "UPSERT 时必须先读现有 target，再写入；证据不足时安全失败，不写 partial content。",
      "Worker 不得把 substantive long-form content 写入 index/navigation doc。",
      "在 document_set_plan 生效时，Worker 不得自行创建规划外 leaf doc；发现需要额外子文档时输出 proposed_extra_tasks 并返回 NEEDS_REPLAN 或 warning。",
      "Leaf substantive doc 必须包含证据与边界；index/navigation doc 不写长篇证据区。",
      "proposed_extra_tasks 只能用于异常溢出；不得把 Planner 本应完成的 Plan A 全集规划转移给 Worker。",
      "若发现 Planner 明显漏规 leaf docs，Worker 应返回 NEEDS_REPLAN，并指出 missing document_set_item_path 或 proposed target。"
    ]
  },
  "validator": {
    "statusValues": [
      "PASS",
      "PASS_WITH_WARNINGS",
      "FAIL"
    ],
    "findingFields": [
      "severity",
      "path",
      "issue",
      "suggested_repair"
    ],
    "severityValues": [
      "error",
      "warning",
      "info"
    ],
    "docKinds": {
      "substantive": "承载项目事实、流程、接口、数据、配置、运维步骤的正文档，必须包含证据与边界。",
      "navigation": "只做目录、索引或跳转的页面，可以没有证据区，但必须链接到有证据区的正文档或明确暂无证据。"
    },
    "rules": [
      "Validator 只读；不写、不删、不格式化正文档。",
      "validate 模式只有在用户明确 repair=true 或明确要求修复时才可进入 Apply。",
      "XS/S 默认 validate-lite：检查 changed targets、入口链接、secret 暴露和明显路径问题。",
      "M/L/XL 或 repair=true 使用完整验证。",
      "只对 substantive docs 强制要求 证据与边界；navigation/index docs 按导航完整性检查。",
      "检查 index_content_sink：index/navigation doc 不得承载多个具体流程、实体、接口、配置、runbook 或诊断正文。",
      "只有 document_set_plan_required=true 时，缺失 document_set_plan 才报告 error；否则最多报告 info 或不报告。",
      "检查 priority=must 的 leaf docs 是否创建、更新或明确 defer，并有 reason/defer_reason。",
      "检查 Worker proposed_extra_tasks 是否被处理、defer 或记录为 evidence gap。",
      "当 document_set_plan_required=true 时，检查 Plan A 是否少列 current scope 内可识别的 leaf docs；明显少列报告 planner_underplanning。",
      "检查 Planner 是否把文档发现职责交给 Worker；若是报告 delegated_discovery_to_worker。",
      "检查 document_set_plan category 是否包含 coverage_basis、coverage_assertion、scope_boundary、excluded_candidates。"
    ],
    "findingTypes": [
      "index_content_sink",
      "missing_required_leaf_doc",
      "index_without_leaf_docs",
      "category_under_split",
      "document_set_plan_missing_when_required",
      "unplanned_leaf_doc",
      "proposed_extra_task_unresolved",
      "secret_exposure",
      "unsafe_path",
      "broken_link",
      "planner_underplanning",
      "delegated_discovery_to_worker",
      "document_set_plan_incomplete_metadata"
    ]
  },
  "executionModes": {
    "native_subagent": {
      "useWhenAvailable": true,
      "spawnStrategy": {
        "router": "at_most_one_per_run",
        "planner": "one_per_active_domain_per_phase_when_flow_requires_planning",
        "worker": "one_per_unique_target_path",
        "validator": "one_or_more_read_only_for_large_validation"
      }
    },
    "serial": {
      "allowed": true,
      "fallbackReasons": [
        "runtime_unavailable",
        "host_policy_blocked",
        "user_forbidden",
        "tooling_unavailable"
      ],
      "mustPreserveRoleBoundaries": true,
      "mustRecordFallbackReason": true
    },
    "leaderMayWrite": [
      "ACTIONDOCK.md",
      "KNOWLEDGE_INIT_REPORT.md",
      "KNOWLEDGE_UPDATE_REPORT.md",
      "KNOWLEDGE_INGEST_REPORT.md",
      "KNOWLEDGE_VALIDATE_REPORT.md",
      "docs/ops/maintenance/errors.md"
    ],
    "leaderMayWriteSubstantiveDocsOnlyWhen": "serial_mode_emulating_worker_for_exactly_one_target_path"
  },
  "reportRequiredFieldsBase": [
    "operation",
    "execution_mode",
    "flow_profile",
    "repo_baseline",
    "files_changed",
    "validation_status",
    "evidence_gaps",
    "scale"
  ],
  "reportFieldsWhenRelevant": [
    "serial_fallback_reason",
    "changed_files",
    "activated_domains",
    "skipped_domains",
    "tasks_completed",
    "tasks_failed",
    "change_types",
    "workspace_scope",
    "special_flags",
    "noise_filters",
    "edit_modes",
    "scenario_findings",
    "document_set_plan_summary",
    "must_leaf_docs",
    "deferred_leaf_docs",
    "proposed_extra_tasks",
    "plan_a_coverage_summary",
    "planner_underplanning_findings"
  ],
  "richnessFloor": {
    "requiredForSubstantiveDocs": [
      "purpose_and_scope",
      "current_behavior",
      "key_files",
      "important_flows_or_lifecycle_when_applicable",
      "interfaces_contracts_or_schemas_when_applicable",
      "operational_notes_when_applicable",
      "evidence_paths",
      "boundaries_gaps_unknowns",
      "maintenance_notes"
    ],
    "preferredChineseSectionHeadings": [
      "目的与范围",
      "当前行为",
      "关键文件",
      "关键流程",
      "接口与契约",
      "数据与状态",
      "运维说明",
      "证据与边界",
      "维护备注"
    ],
    "navigationDocsExemptFromEvidenceSection": true,
    "rule": "不要用短摘要替代长期可维护文档。XS/S 可做局部最小编辑；新 substantive doc 仍需包含证据与边界。"
  },
  "coverageFloor": {
    "domainsMustBeConsideredImplicitly": true,
    "explicitSkipRequiredWhen": [
      "M_or_larger_material_domain",
      "user_requested_domain",
      "risk_or_conflict",
      "blocked_by_missing_files",
      "unsafe_path"
    ],
    "xs_s_do_not_require_all_skips": true,
    "allowedSkipReasons": [
      "no_relevant_evidence",
      "unchanged_from_current_docs",
      "outside_requested_scope",
      "blocked_by_missing_files",
      "unsafe_path",
      "insufficient_confidence",
      "deferred_by_scale_lite"
    ]
  },
  "pathSafety": {
    "allowedTargetPatterns": [
      "ACTIONDOCK.md",
      "KNOWLEDGE_INIT_REPORT.md",
      "KNOWLEDGE_UPDATE_REPORT.md",
      "KNOWLEDGE_INGEST_REPORT.md",
      "KNOWLEDGE_VALIDATE_REPORT.md",
      "docs/"
    ],
    "allowedInboxCleanupRoot": ".kb_inbox/",
    "forbiddenSegments": [
      "..",
      ".git",
      "node_modules",
      "dist",
      "build",
      "target",
      ".cache",
      "coverage"
    ],
    "forbidAbsolutePaths": true,
    "forbidWildcardsInResolvedTargets": true,
    "requireRealpathContainment": true,
    "rejectSymlinkEscape": true,
    "requireAtomicUpsert": true,
    "forbidDirectoryDeletion": true,
    "newFileRule": "若 target_path 尚不存在，先 resolve 其父目录真实路径；父目录必须在 repoPath 内且不能通过 symlink 逃逸。",
    "segmentRule": "forbiddenSegments 按路径段匹配，不按普通子串匹配。",
