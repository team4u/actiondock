{
  "version": 4,
  "inputs": {
    "required": ["repoPath"],
    "optional": [
      "operation",
      "changedFiles",
      "inboxPaths",
      "resume",
      "projectName",
      "audience",
      "detailLevel",
      "profile",
      "maxFanout",
      "allowNewDocs",
      "forceFullValidate"
    ],
    "defaults": {
      "operation": "auto",
      "resume": true,
      "audience": "future agents and engineers",
      "detailLevel": "evidence-bound and decision-useful",
      "profile": "standard",
      "maxFanout": 4,
      "allowNewDocs": true,
      "forceFullValidate": false
    }
  },
  "operations": ["auto", "init", "refresh", "ingest", "validate"],
  "outputs": {
    "entry": "ACTIONDOCK.md",
    "formalRoot": "docs",
    "metadataRoot": "docs/_meta",
    "knowledgeMap": "docs/_meta/knowledge-map.json",
    "inboxRoot": ".kb_inbox",
    "reports": {
      "init": "KNOWLEDGE_INIT_REPORT.md",
      "refresh": "KNOWLEDGE_UPDATE_REPORT.md",
      "ingest": "KNOWLEDGE_INGEST_REPORT.md",
      "validate": "KNOWLEDGE_VALIDATE_REPORT.md"
    },
    "errorLog": "docs/ops/maintenance/errors.md"
  },
  "domains": [
    "Chief_Architect",
    "API_Spec_Planner",
    "Data_Model_Planner",
    "Business_Flow_Planner",
    "Agent_Tool_Planner",
    "Infra_Env_Planner",
    "Maintenance_Ops_Planner",
    "Triage_Planner"
  ],
  "phaseDefaults": [
    {
      "phase_num": 0,
      "domains_to_activate": ["Data_Model_Planner", "Infra_Env_Planner", "Triage_Planner"]
    },
    {
      "phase_num": 1,
      "domains_to_activate": ["API_Spec_Planner", "Business_Flow_Planner", "Agent_Tool_Planner"]
    },
    {
      "phase_num": 2,
      "domains_to_activate": ["Chief_Architect", "Maintenance_Ops_Planner"]
    }
  ],
  "profiles": {
    "thin": {
      "maxChangedFiles": 5,
      "maxTargets": 2,
      "chiefMode": "skip_only_when_obvious",
      "plannerMode": "skip_only_when_owner_and_significance_are_obvious",
      "docDepth": "full_for_any_upsert"
    },
    "standard": {
      "default": true,
      "chiefMode": "required",
      "plannerMode": "one_per_active_domain_per_phase",
      "docDepth": "full"
    },
    "deep": {
      "chiefMode": "required",
      "plannerMode": "one_per_active_domain_per_phase",
      "strictPhaseBarriers": true,
      "ownershipRepair": true,
      "docDepth": "full"
    }
  },
  "chiefOutput": {
    "required": ["profile", "phases"],
    "phaseFields": ["phase_num", "domains_to_activate"],
    "optionalPhaseFields": ["reason"]
  },
  "targetTask": {
    "required": [
      "action",
      "target_path",
      "kind",
      "evidence_paths",
      "existing_doc_paths",
      "confidence",
      "nav_impact",
      "focus_code_entity",
      "clue"
    ],
    "actionValues": ["UPSERT", "PRUNE"],
    "confidenceValues": ["high", "medium", "low"]
  },
  "plannerOutput": {
    "required": ["tasks", "deferred", "skipped"],
    "deferredItemFields": ["target_path", "evidence_paths", "impact", "reason"],
    "skippedItemFields": ["item", "impact", "reason"]
  },
  "impactAnalyzerOutput": {
    "required": ["decisions"],
    "decisionFields": [
      "decision",
      "impact",
      "target_path",
      "action",
      "kind",
      "evidence_paths",
      "existing_doc_paths",
      "confidence",
      "nav_impact",
      "reason"
    ]
  },
  "knowledgeImpact": {
    "levels": ["material", "minor", "noise"],
    "decisionValues": ["write", "defer", "skip"],
    "defaultWriteThreshold": "material",
    "deferLimitPerTarget": 5
  },
  "operationReportFields": [
    "operation",
    "profile",
    "updated_targets",
    "deferred_updates",
    "skipped_low_significance",
    "failed_tasks",
    "evidence_gaps",
    "validation_status"
  ],
  "worker": {
    "maxRetries": 3,
    "allowedActions": ["UPSERT", "PRUNE"],
    "statusValues": ["COMPLETED", "FAILED", "SKIPPED"]
  },
  "subagents": {
    "requiredWhenAvailable": true,
    "serialFallbackAllowed": true,
    "fallbackReasons": ["runtime_unavailable", "host_policy_blocked", "user_forbidden"],
    "roles": ["chief", "impact_analyzer", "planner", "worker"],
    "spawnStrategy": {
      "chief": "one_per_standard_or_deep_run",
      "impact_analyzer": "zero_or_one_per_run",
      "planner": "one_per_active_domain_per_phase",
      "worker": "one_per_unique_target_path"
    },
    "leaderMayWrite": [
      "ACTIONDOCK.md",
      "KNOWLEDGE_INIT_REPORT.md",
      "KNOWLEDGE_UPDATE_REPORT.md",
      "KNOWLEDGE_INGEST_REPORT.md",
      "KNOWLEDGE_VALIDATE_REPORT.md",
      "docs/_meta/knowledge-map.json"
    ],
    "requiredReportFields": [
      "subagent_mode",
      "subagent_unavailable_fallback",
      "fallback_reason",
      "chief_agent",
      "impact_analyzer",
      "planner_agents",
      "worker_agents"
    ]
  },
  "pathSafety": {
    "allowedFormalPrefixes": [
      "ACTIONDOCK.md",
      "KNOWLEDGE_INIT_REPORT.md",
      "KNOWLEDGE_UPDATE_REPORT.md",
      "KNOWLEDGE_INGEST_REPORT.md",
      "KNOWLEDGE_VALIDATE_REPORT.md",
      "docs/"
    ],
    "forbiddenSegments": ["..", ".git", "node_modules", "dist", "build", "target", ".cache", "coverage"],
    "forbidAbsolutePaths": true,
    "forbidWildcards": true
  },
  "validateChecks": [
    "entry_links_exist",
    "evidence_section_present",
    "freshness_recorded",
    "owner_mapping_present",
    "duplicate_or_orphan_docs",
    "sensitive_data_redacted",
    "doc_depth_matches_kind"
  ]
}
