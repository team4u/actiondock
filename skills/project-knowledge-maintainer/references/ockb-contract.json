{
  "version": 3,
  "inputs": {
    "required": ["repoPath"],
    "optional": [
      "operation",
      "changedFiles",
      "inboxPaths",
      "resume",
      "projectName",
      "audience",
      "detailLevel",
      "maxFanout",
      "allowNewDocs",
      "forceFullValidate"
    ],
    "defaults": {
      "operation": "auto",
      "resume": true,
      "audience": "future agents and engineers",
      "detailLevel": "evidence-bound",
      "maxFanout": 4,
      "allowNewDocs": true,
      "forceFullValidate": false
    }
  },
  "operations": ["auto", "init", "refresh", "ingest", "validate"],
  "outputs": {
    "entry": "ACTIONDOCK.md",
    "formalRoot": "docs",
    "metadataRoot": "docs/_meta",
    "knowledgeMap": "docs/_meta/knowledge-map.json",
    "inboxRoot": ".kb_inbox",
    "reports": {
      "init": "KNOWLEDGE_INIT_REPORT.md",
      "refresh": "KNOWLEDGE_UPDATE_REPORT.md",
      "ingest": "KNOWLEDGE_INGEST_REPORT.md",
      "validate": "KNOWLEDGE_VALIDATE_REPORT.md"
    },
    "errorLog": "docs/ops/maintenance/errors.md"
  },
  "domains": [
    "Architecture",
    "API",
    "Data",
    "BusinessFlow",
    "AgentTooling",
    "InfraEnv",
    "MaintenanceOps",
    "Triage"
  ],
  "phaseDefaults": [
    {
      "phase_num": 0,
      "domains_to_activate": ["Data", "InfraEnv", "Triage"]
    },
    {
      "phase_num": 1,
      "domains_to_activate": ["API", "BusinessFlow", "AgentTooling"]
    },
    {
      "phase_num": 2,
      "domains_to_activate": ["Architecture", "MaintenanceOps"]
    }
  ],
  "chiefOutput": {
    "required": ["profile", "phases"],
    "phaseFields": ["phase_num", "domains_to_activate"],
    "optionalPhaseFields": ["reason"]
  },
  "profiles": {
    "thin": {
      "maxChangedFiles": 5,
      "maxTargets": 2,
      "broadChangeTriggers": ["build-root", "schema-root", "infra-root"],
      "chiefMode": "skip_by_default",
      "plannerMode": "target_scoped_or_skip"
    },
    "standard": {
      "maxChangedFiles": 25,
      "maxTargets": 5,
      "chiefMode": "required",
      "plannerMode": "per_active_domain_per_phase"
    },
    "deep": {
      "requiresFullValidate": true,
      "chiefMode": "required",
      "plannerMode": "per_active_domain_per_phase",
      "strictPhaseBarriers": true
    }
  },
  "targetTask": {
    "required": [
      "mode",
      "target_path",
      "kind",
      "evidence_paths",
      "existing_doc_paths",
      "confidence",
      "nav_impact"
    ],
    "modeValues": ["create", "update", "prune"],
    "confidenceValues": ["high", "medium", "low"]
  },
  "plannerOutput": {
    "required": ["tasks", "deferred", "skipped"],
    "deferredItemFields": ["target_path", "evidence_paths", "impact", "reason"],
    "skippedItemFields": ["item", "reason"]
  },
  "knowledgeImpact": {
    "levels": ["material", "minor", "noise"],
    "decisionValues": ["write", "defer", "skip"],
    "defaultWriteThreshold": "material",
    "deferLimitPerTarget": 5
  },
  "operationReportFields": [
    "updated_targets",
    "deferred_updates",
    "skipped_low_significance",
    "evidence_gaps"
  ],
  "worker": {
    "maxRetries": 3,
    "statusValues": ["COMPLETED", "FAILED", "SKIPPED"]
  },
  "subagents": {
    "requiredWhenAvailable": true,
    "serialFallbackAllowed": true,
    "fallbackReasons": ["runtime_unavailable", "host_policy_blocked", "user_forbidden"],
    "roles": ["chief", "impact_analyzer", "planner", "worker"],
    "leaderMayWrite": [
      "ACTIONDOCK.md",
      "KNOWLEDGE_INIT_REPORT.md",
      "KNOWLEDGE_UPDATE_REPORT.md",
      "KNOWLEDGE_INGEST_REPORT.md",
      "KNOWLEDGE_VALIDATE_REPORT.md",
      "docs/_meta/knowledge-map.json"
    ],
    "requiredReportFields": [
      "subagent_mode",
      "subagent_unavailable_fallback",
      "fallback_reason",
      "chief_agent",
      "impact_analyzer",
      "planner_agents",
      "worker_agents"
    ]
  },
  "pathSafety": {
    "allowedFormalPrefixes": [
      "ACTIONDOCK.md",
      "KNOWLEDGE_INIT_REPORT.md",
      "KNOWLEDGE_UPDATE_REPORT.md",
      "KNOWLEDGE_INGEST_REPORT.md",
      "KNOWLEDGE_VALIDATE_REPORT.md",
      "docs/"
    ],
    "forbiddenSegments": ["..", ".git", "node_modules", "dist", "build", "target", ".cache", "coverage"],
    "forbidAbsolutePaths": true,
    "forbidWildcards": true
  },
  "validateChecks": [
    "entry_links_exist",
    "evidence_section_present",
    "freshness_recorded",
    "owner_mapping_present",
    "duplicate_or_orphan_docs",
    "sensitive_data_redacted"
  ]
}
