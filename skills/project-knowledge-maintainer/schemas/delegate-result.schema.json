{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DelegateResult",
  "type": "object",
  "required": [
    "stage",
    "status",
    "summary",
    "outputs",
    "evidence",
    "risks",
    "next_action"
  ],
  "properties": {
    "stage": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "NEEDS_REPLAN",
        "UNAVAILABLE",
        "TIMEOUT_REPORTED",
        "WAITING"
      ]
    },
    "target_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "outputs": {
      "type": "object"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_extra_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_action": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
