{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPlan",
  "type": "object",
  "required": [
    "tasks",
    "phases",
    "delegate_policy"
  ],
  "properties": {
    "delegate_policy": {
      "type": "object",
      "required": [
        "execution_mode",
        "must_wait_for_results"
      ],
      "properties": {
        "execution_mode": {
          "enum": [
            "team_agent",
            "native_subagent",
            "serial"
          ]
        },
        "must_wait_for_results": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "stage",
          "target_path",
          "derived_from_plan_a",
          "delegate_required",
          "acceptance_criteria"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "target_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "derived_from_plan_a": {
            "type": "boolean"
          },
          "delegate_required": {
            "type": "boolean"
          },
          "assigned_delegate": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "domain_planner_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "delegate_required",
          "assigned_delegate",
          "status"
        ],
        "properties": {
          "domain": {
            "enum": [
              "architecture",
              "api",
              "data",
              "business_flow",
              "agent_tool",
              "infra_env",
              "maintenance_ops",
              "other"
            ]
          },
          "delegate_required": {
            "type": "boolean"
          },
          "assigned_delegate": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PLANNED",
              "DISPATCHED",
              "COMPLETED",
              "FAILED",
              "BLOCKED",
              "UNAVAILABLE",
              "TIMEOUT_REPORTED"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
