{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskPlanB",
  "type": "object",
  "required": [
    "plan_b_id",
    "derived_from_plan_a",
    "phases"
  ],
  "properties": {
    "plan_b_id": {
      "type": "string"
    },
    "derived_from_plan_a": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "purpose",
          "tasks"
        ],
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": 0
          },
          "purpose": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "target_path",
                "delegate",
                "acceptance_criteria",
                "plan_a_ref"
              ],
              "properties": {
                "task_id": {
                  "type": "string"
                },
                "target_path": {
                  "type": "string"
                },
                "delegate": {
                  "enum": [
                    "subagent",
                    "serial"
                  ]
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "plan_a_ref": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
