<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>org.team4u</groupId>
    <artifactId>scriptflow</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>
    <name>scriptflow</name>
    <description>Multi-module Spring Scriptflow runtime with H2 and script execution</description>

    <modules>
        <module>scriptflow-core</module>
        <module>scriptflow-storage-jpa</module>
        <module>scriptflow-app-spring</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <groovy.version>4.0.24</groovy.version>
        <picocli.version>4.7.6</picocli.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
