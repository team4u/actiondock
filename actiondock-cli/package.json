{
  "name": "actiondock-cli",
  "version": "0.2.0",
  "description": "ActionDock official REST CLI",
  "author": "jay.wu <fjayblue@126.com>",
  "license": "MIT",
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/fjay/script-flow.git"
  },
  "bin": {
    "actiondock": "jdeploy-bundle/jdeploy.js"
  },
  "files": [
    "jdeploy-bundle"
  ],
  "dependencies": {
    "command-exists-promise": "^2.0.2",
    "node-fetch": "2.6.7",
    "shelljs": "^0.8.4",
    "tar": "^4.4.8",
    "yauzl": "^2.10.0"
  },
  "scripts": {
    "jdeploy:package": "jdeploy package",
    "pack:dry-run": "npm pack --dry-run"
  },
  "jdeploy": {
    "jar": "target/actiondock-cli.jar",
    "javaVersion": "21",
    "title": "ActionDock CLI",
    "commands": {
      "actiondock": {
        "description": "ActionDock official REST CLI"
      }
    }
  }
}
