{
  "pluginId": "actiondock-browser",
  "name": "ActionDock Browser",
  "description": "AI-first Playwright browser gateway. Use observe to understand the page, then act/evaluate/wait/pages/events to complete browser tasks.",
  "version": "0.3.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "defaultBrowser": {
        "type": "string",
        "enum": ["chromium", "firefox", "webkit"],
        "title": "Default Browser"
      },
      "headless": {
        "type": "boolean",
        "title": "Headless"
      },
      "defaultTimeoutMs": {
        "type": "integer",
        "title": "Default Timeout Milliseconds"
      },
      "sessionTtlSeconds": {
        "type": "integer",
        "title": "Session TTL Seconds"
      },
      "maxSessions": {
        "type": "integer",
        "title": "Max Sessions"
      },
      "stateDir": {
        "type": "string",
        "title": "State Directory"
      },
      "artifactDir": {
        "type": "string",
        "title": "Artifact Directory"
      },
      "downloadDir": {
        "type": "string",
        "title": "Download Directory"
      },
      "allowedHosts": {
        "type": "array",
        "items": { "type": "string" },
        "title": "Allowed Hosts"
      },
      "includeCookieValueByDefault": {
        "type": "boolean",
        "title": "Include Cookie Value By Default"
      }
    }
  },
  "defaultConfig": {
    "defaultBrowser": "chromium",
    "headless": true,
    "defaultTimeoutMs": 30000,
    "sessionTtlSeconds": 600,
    "maxSessions": 10,
    "stateDir": ".actiondock/browser-state",
    "artifactDir": ".actiondock/browser-artifacts",
    "downloadDir": ".actiondock/browser-downloads",
    "allowedHosts": [],
    "includeCookieValueByDefault": false
  },
  "actions": [
    {
      "action": "sessionCreate",
      "title": "Create Browser Session",
      "description": "Create a Playwright browser session and return sessionId plus the first pageId. Supports common browser context options.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "browser": { "type": "string", "enum": ["chromium", "firefox", "webkit"] },
          "headless": { "type": "boolean" },
          "timeoutMs": { "type": "integer" },
          "viewport": { "type": "object" },
          "userAgent": { "type": "string" },
          "locale": { "type": "string" },
          "timezoneId": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "geolocation": { "type": "object" },
          "extraHTTPHeaders": { "type": "object" },
          "httpCredentials": { "type": "object" },
          "ignoreHTTPSErrors": { "type": "boolean" },
          "javaScriptEnabled": { "type": "boolean" },
          "isMobile": { "type": "boolean" },
          "hasTouch": { "type": "boolean" },
          "stateName": { "type": "string" },
          "storageStatePath": { "type": "string" }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "browser": { "type": "string" },
          "headless": { "type": "boolean" }
        }
      },
      "exampleArgs": { "browser": "chromium", "headless": true }
    },
    {
      "action": "observe",
      "title": "Observe Page",
      "description": "Read the current page for AI planning. Returns URL, title, ARIA snapshot, visible text, forms, frames, recent events, and actionable element refs such as e1/e2 for use by act/evaluate/wait.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "limit": { "type": "integer" },
          "maxTextLength": { "type": "integer" }
        },
        "required": ["sessionId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "url": { "type": "string" },
          "title": { "type": "string" },
          "ariaSnapshot": { "type": "string" },
          "visibleText": { "type": "string" },
          "elements": { "type": "array" },
          "forms": { "type": "array" },
          "frames": { "type": "array" },
          "events": { "type": "array" }
        }
      },
      "exampleArgs": { "sessionId": "br_xxx", "limit": 80 }
    },
    {
      "action": "act",
      "title": "Perform Browser Action",
      "description": "Perform a Playwright action. Use target.ref from observe when possible. Common ops: goto, reload, back, forward, click, dblclick, hover, fill, type, clear, press, check, uncheck, setChecked, selectOption, setInputFiles, focus, blur, scrollIntoView, selectText, tap, dispatchEvent, dragTo, setContent, addScriptTag, addStyleTag, screenshot, locatorScreenshot, pdf, dialogAccept, dialogDismiss, downloadSaveAs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "op": { "type": "string" },
          "target": { "type": "object" },
          "args": { "type": "object" },
          "options": { "type": "object" }
        },
        "required": ["sessionId", "op"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "url": { "type": "string" },
          "title": { "type": "string" },
          "op": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "exampleArgs": {
        "sessionId": "br_xxx",
        "op": "setChecked",
        "target": { "ref": "e3" },
        "args": { "checked": true }
      }
    },
    {
      "action": "evaluate",
      "title": "Evaluate JavaScript",
      "description": "Run unrestricted Playwright JavaScript evaluation on the page, a locator, or all matching locators. Scopes: page, locator, all.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "scope": { "type": "string", "enum": ["page", "locator", "all"] },
          "target": { "type": "object" },
          "expression": { "type": "string" },
          "arg": {}
        },
        "required": ["sessionId", "expression"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "value": {}
        }
      },
      "exampleArgs": {
        "sessionId": "br_xxx",
        "scope": "page",
        "expression": "() => document.title"
      }
    },
    {
      "action": "wait",
      "title": "Wait For Browser Condition",
      "description": "Wait for a browser condition. Kinds: loadState, selector, url, function, request, response, console, popup, download, timeout.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "for": { "type": "string" },
          "target": { "type": "object" },
          "url": { "type": "string" },
          "state": { "type": "string" },
          "expression": { "type": "string" },
          "arg": {},
          "timeoutMs": { "type": "integer" }
        },
        "required": ["sessionId", "for"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "for": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "exampleArgs": { "sessionId": "br_xxx", "for": "selector", "target": { "text": "完成" }, "timeoutMs": 30000 }
    },
    {
      "action": "pages",
      "title": "Manage Pages",
      "description": "Manage pages/tabs. Ops: list, new, switch, close, bringToFront.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "op": { "type": "string" },
          "pageId": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["sessionId", "op"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "activePageId": { "type": "string" },
          "op": { "type": "string" },
          "data": {}
        }
      },
      "exampleArgs": { "sessionId": "br_xxx", "op": "list" }
    },
    {
      "action": "events",
      "title": "Read Browser Events",
      "description": "Read buffered browser events such as console, pageError, request, response, popup, download, and dialog. Use clear=true to reset the buffer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": { "type": "string" },
          "pageId": { "type": "string" },
          "types": { "type": "array", "items": { "type": "string" } },
          "sinceId": { "type": "integer" },
          "clear": { "type": "boolean" }
        },
        "required": ["sessionId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "events": { "type": "array" },
          "count": { "type": "integer" },
          "cleared": { "type": "boolean" }
        }
      },
      "exampleArgs": { "sessionId": "br_xxx", "types": ["console", "pageError"] }
    },
    {
      "action": "sessionInfo",
      "title": "Get Session Info",
      "description": "Read browser session metadata, active page, and open pages.",
      "inputSchema": {
        "type": "object",
        "properties": { "sessionId": { "type": "string" } },
        "required": ["sessionId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "activePageId": { "type": "string" },
          "pages": { "type": "array" }
        }
      },
      "exampleArgs": { "sessionId": "br_xxx" }
    },
    {
      "action": "sessionList",
      "title": "List Sessions",
      "description": "List active browser sessions owned by current script execution.",
      "inputSchema": { "type": "object", "properties": {} },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessions": { "type": "array" },
          "count": { "type": "integer" }
        }
      },
      "exampleArgs": {}
    },
    {
      "action": "sessionClose",
      "title": "Close Browser Session",
      "description": "Close a browser session and release Playwright resources.",
      "inputSchema": {
        "type": "object",
        "properties": { "sessionId": { "type": "string" } },
        "required": ["sessionId"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "sessionId": { "type": "string" },
          "closed": { "type": "boolean" }
        }
      },
      "exampleArgs": { "sessionId": "br_xxx" }
    }
  ]
}
