{
  "name": "actiondock-monorepo",
  "version": "2.0.12",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "test": "bun test",
    "test:pack": "bun run ./scripts/pack-smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run ./scripts/build.ts",
    "bump": "bun run ./scripts/bump-version.ts",
    "docs:serve": "bunx docsify-cli serve docs"
  },
  "dependencies": {
    "@actiondock/builder": "^2.0.12",
    "@actiondock/cli": "^2.0.12",
    "@actiondock/core": "^2.0.12",
    "@actiondock/mcp": "^2.0.12",
    "@actiondock/runtime-node": "^2.0.12",
    "@actiondock/sdk": "^2.0.12",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.13.0"
  },
  "devDependencies": {
    "execa": "^10.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
