{
  "name": "actiondock-monorepo",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "test": "node ./scripts/run-tests.ts",
    "test:pack": "node ./scripts/pack-smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node ./scripts/build.ts",
    "bump": "node ./scripts/bump-version.ts",
    "docs:serve": "npx docsify-cli serve docs"
  },
  "dependencies": {
    "@actiondock/builder": "^2.2.2",
    "@actiondock/cli": "^2.2.2",
    "@actiondock/core": "^2.2.2",
    "@actiondock/mcp": "^2.2.2",
    "@actiondock/runtime-node": "^2.2.2",
    "@actiondock/sdk": "^2.2.2",
    "@actiondock/testing": "^2.2.2",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.7.0"
  }
}
